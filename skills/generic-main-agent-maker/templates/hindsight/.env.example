# SPDX-License-Identifier: MIT
# Vorlage -> geschützte lokale .env, NICHT im Checkout, chmod 600.
# Leerwerte sind bewusst keine Infrastrukturbehauptungen. ALLE Pflichtwerte ausfüllen.
# Keine Shellbefehle; niemals source .env. Keine $-Interpolation in Werten.
COMPOSE_PROJECT_NAME=
# Quellenkandidaten: ghcr.io/vectorize-io/hindsight-api:1.0.0-slim
# und pgvector/pgvector:0.8.7-pg18-bookworm.
# Später aus echter Registry bestimmen: repository:tag@sha256:<64 echte Hexzeichen>.
HINDSIGHT_IMAGE=
POSTGRES_IMAGE=
# Freien lokalen Port vorher prüfen; kein zugesicherter Beispielport.
HINDSIGHT_DB_PORT=
# Drei voneinander unabhängige, lokal erzeugte 64-stellige Hex-Geheimnisse:
POSTGRES_ADMIN_PASSWORD=
HINDSIGHT_DB_PASSWORD=
HINDSIGHT_API_TOKEN=
# Bereits bereitgestellter IPv4-Loopback-Endpoint, einschließlich /v1.
LLM_BASE_URL=
LLM_MODEL_ID=
LLM_API_KEY=
# Betreiber liefert OpenAI Chat Completions + json_schema/strict Unterstützung.
# Kein OpenAI-Cloud-Ziel, kein stiller Ersatzprovider.
# TEI-Basis-URLs ohne /embed bzw. /rerank, nur http://127.0.0.1:<bereitgestellter-Port>.
EMBEDDING_TEI_URL=
RERANKER_TEI_URL=
# Nur lokale Prüf-/Inventarwerte, nicht automatisch als Hindsight-ENV injiziert:
EMBEDDING_MODEL_ID=
EMBEDDING_DIMENSION=
RERANKER_MODEL_ID=
# Exakte Präfixe vom Betreiber; bei Bedarf einfach zitieren: 'query: '
# Leer nur, wenn das konkrete Modell keine clientseitigen Präfixe braucht.
EMBEDDING_QUERY_PREFIX=
EMBEDDING_PASSAGE_PREFIX=
# Eigene neue Bank und separate neue synthetische Abnahmebank; [a-z0-9_-]+.
HINDSIGHT_BANK_ID=
HINDSIGHT_TEST_BANK_ID=
